{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloud Mail REST API",
    "version": "2.0.0",
    "description": "Cloud Mail REST API。用户 Key 与管理员 Key 分开管理，并分别受用户 REST API 和管理员 REST API 开关控制。"
  },
  "servers": [
    {
      "url": "https://mail.airoute.kdns.fr/api/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "summary": "获取当前用户",
        "description": "返回 API Key 所属用户的基本信息。 只能访问 API Key 所属用户自己的资源。",
        "operationId": "get_me",
        "parameters": [],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "curl",
            "source": "curl --request GET \\\n  --url \"https://mail.airoute.kdns.fr/api/v1/me\" \\\n  --header \"Authorization: Bearer YOUR_API_KEY\""
          }
        ]
      }
    },
    "/accounts": {
      "get": {
        "summary": "查询邮箱账号",
        "description": "查询主账号和子账号。使用游标分页。 只能访问 API Key 所属用户自己的资源。",
        "operationId": "get_accounts",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "上一页返回的 nextCursor；第一页省略。",
            "schema": {
              "type": "integer"
            },
            "example": 123
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页数量，1-50，默认 20。",
            "schema": {
              "type": "integer"
            },
            "example": 20
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "curl",
            "source": "curl --request GET \\\n  --url \"https://mail.airoute.kdns.fr/api/v1/accounts?limit=20\" \\\n  --header \"Authorization: Bearer YOUR_API_KEY\""
          }
        ]
      },
      "post": {
        "summary": "批量创建子邮箱",
        "description": "请求体可直接传数组，也可传 {emails:[...]}；每次 1-50 个。已被当前用户删除的子邮箱可用相同地址重新添加，恢复原 accountId，并可通过 name 指定显示名称；其他用户删除的地址不可抢占。响应统一返回 items 数组。只能访问 API Key 所属用户自己的资源。",
        "operationId": "post_accounts",
        "parameters": [],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "curl",
            "source": "curl --request POST \\\n  --url \"https://mail.airoute.kdns.fr/api/v1/accounts\" \\\n  --header \"Authorization: Bearer YOUR_API_KEY\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '[\"batch-one@mail.airoute.kdns.fr\",{\"email\":\"batch-two@mail.airoute.kdns.fr\",\"name\":\"Batch Two\"}]'"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "format": "email"
                        },
                        {
                          "type": "object",
                          "required": [
                            "email"
                          ],
                          "properties": {
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 30
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "emails": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 50
                      }
                    }
                  }
                ]
              },
              "example": [
                "batch-one@mail.airoute.kdns.fr",
                {
                  "email": "batch-two@mail.airoute.kdns.fr",
                  "name": "Batch Two"
                }
              ]
            }
          }
        }
      }
    },
    "/accounts/{accountId}": {
      "patch": {
        "summary": "修改邮箱账号",
        "description": "name 会立即修改本人有效邮箱账号的显示名称（去除首尾空格，最长 30 个字符）；后续新邮件仍归属同一 accountId，并可用新名称筛选。allReceive 为 0/1，用于设置聚合收件账号。只能访问 API Key 所属用户自己的资源。",
        "operationId": "patch_accounts_accountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "本人邮箱账号 ID。",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "curl",
            "source": "curl --request PATCH \\\n  --url \"https://mail.airoute.kdns.fr/api/v1/accounts/2\" \\\n  --header \"Authorization: Bearer YOUR_API_KEY\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '{\"name\":\"Automation\",\"allReceive\":0}'"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "allReceive": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                }
              },
              "example": {
                "name": "Automation",
                "allReceive": 0
              }
            }
          }
        }
      },
      "delete": {
        "summary": "删除子邮箱账号",
        "description": "软删除本人子邮箱账号并关闭聚合收件；主账号不能删除。删除后可由原所有者通过 POST /accounts 使用相同邮箱地址恢复，历史邮件状态不变，新邮件可继续接收。只能访问 API Key 所属用户自己的资源。",
        "operationId": "delete_accounts_accountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "本人子邮箱账号 ID。",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "curl",
            "source": "curl --request DELETE \\\n  --url \"https://mail.airoute.kdns.fr/api/v1/accounts/2\" \\\n  --header \"Authorization: Bearer YOUR_API_KEY\""
          }
        ]
      }
    },
    "/emails": {
      "get": {
        "summary": "筛选邮件",
        "description": "支持按时间、主/子账号 ID、账号名称或完整邮箱筛选。 只能访问 API Key 所属用户自己的资源。",
        "operationId": "get_emails",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "上一页返回的 nextCursor（emailId）。",
            "schema": {
              "type": "integer"
            },
            "example": 999999
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "每页数量，1-50，默认 20。",
            "schema": {
              "type": "integer"
            },
            "example": 20
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "主账号或子账号 ID。",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "accountName",
            "in": "query",
            "required": false,
            "description": "账号显示名或完整邮箱；与 accountId 二选一。",
            "schema": {
              "type": "string"
            },
            "example": "admin"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "0=收件，1=发件。",
            "schema": {
              "type": "integer"
            },
            "example": 0
          },
          {
            "name": "unread",
            "in": "query",
            "required": false,
            "description": "0=未读，1=已读。",
            "schema": {
              "type": "integer"
            },
            "example": 0
          },
          {
            "name": "startTime",
            "in": "query",
            "required": false,
            "description": "起始时间（含），格式 YYYY-MM-DD HH:mm:ss。",
            "schema": {
              "type": "string"
            },
            "example": "2026-08-01 00:00:00"
          },
          {
            "name": "endTime",
            "in": "query",
            "required": false,
            "description": "结束时间（含），格式 YYYY-MM-DD HH:mm:ss。",
            "schema": {
              "type": "string"
            },
            "example": "2026-08-31 23:59:59"
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "curl",
            "source": "curl --request GET \\\n  --url \"https://mail.airoute.kdns.fr/api/v1/emails?cursor=999999&limit=20&accountName=admin&type=0&unread=0&startTime=2026-08-01+00%3A00%3A00&endTime=2026-08-31+23%3A59%3A59\" \\\n  --header \"Authorization: Bearer YOUR_API_KEY\""
          }
        ]
      },
      "delete": {
        "summary": "批量删除邮件",
        "description": "一次软删除 1-100 封本人邮件；不属于当前用户的 ID 会被忽略。 只能访问 API Key 所属用户自己的资源。",
