    "/admin/settings": {
      "patch": {
        "summary": "管理员修改 REST API/多号设置",
        "description": "只接受 0/1。restApiEnabled:0 开启用户 REST API，只控制用户 Key；adminRestApiEnabled:0 开启管理员 REST API，只控制管理员 Key；manyEmail:0 开启多号模式；addEmail:0 允许添加邮箱。两个 API 开关互不影响。必须使用管理员专用 API Key。",
        "operationId": "patch_admin_settings",
        "parameters": [],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "curl",
            "source": "curl --request PATCH \\\n  --url \"https://mail.airoute.kdns.fr/api/v1/admin/settings\" \\\n  --header \"Authorization: Bearer YOUR_API_KEY\" \\\n  --header \"Content-Type: application/json\" \\\n  --data '{\"restApiEnabled\":0,\"adminRestApiEnabled\":0,\"manyEmail\":0,\"addEmail\":0}'"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "restApiEnabled": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "0=开启用户 REST API，1=关闭"
                  },
                  "adminRestApiEnabled": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ],
                    "description": "0=开启管理员 REST API，1=关闭"
                  },
                  "manyEmail": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "addEmail": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  }
                }
              },
              "example": {
                "restApiEnabled": 0,
                "adminRestApiEnabled": 0,
                "manyEmail": 0,
                "addEmail": 0
              }
            }
          }
        }
      }
    }
